# Copie para .env (que fica fora do git) e preencha só o que for usar.
# Sem nada preenchido, o projeto roda no modo local (DuckDB em data/painel.duckdb).

# Modo nuvem: Postgres do Supabase (Project Settings > Database > Connection string, modo "Session pooler")
DATABASE_URL=

# Conexão somente leitura para o MCP do agente (um usuário com permissão só de SELECT)
DATABASE_URL_RO=

# Supabase Storage para guardar o JSON bruto (opcional)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=raw
